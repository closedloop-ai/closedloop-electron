{
  "name": "@closedloop-ai/design-system",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./lib/fonts": {
      "types": "./dist/lib/fonts.d.ts",
      "import": "./dist/lib/fonts.js",
      "require": "./dist/lib/fonts.cjs",
      "default": "./dist/lib/fonts.js"
    },
    "./styles/globals.css": {
      "default": "./styles/globals.css"
    },
    "./postcss.config.mjs": {
      "default": "./postcss.config.mjs"
    },
    "./storybook/component-catalog": {
      "types": "./dist/storybook/component-catalog.d.ts",
      "import": "./dist/storybook/component-catalog.js",
      "require": "./dist/storybook/component-catalog.cjs",
      "default": "./dist/storybook/component-catalog.js"
    },
    "./storybook/mock-data": {
      "types": "./dist/storybook/mock-data.d.ts",
      "import": "./dist/storybook/mock-data.js",
      "require": "./dist/storybook/mock-data.cjs",
      "default": "./dist/storybook/mock-data.js"
    },
    "./components/ui/*": {
      "types": "./dist/components/ui/*.d.ts",
      "import": "./dist/components/ui/*.mjs",
      "require": "./dist/components/ui/*.js",
      "default": "./dist/components/ui/*.mjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "next-themes": "^0.4.0",
    "react": "^19.0.0",
    "react-day-picker": "^9.0.0",
    "react-hook-form": "^7.0.0",
    "react-resizable-panels": "^3.0.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-icons": "^1.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "embla-carousel-react": "^8.6.0",
    "geist": "^1.7.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.556.0",
    "radix-ui": "^1.4.0",
    "react-markdown": "^10.1.0",
    "react-moveable": "^0.56.0",
    "react-syntax-highlighter": "^16.1.0",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  }
}
