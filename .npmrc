@closedloop-ai:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}

# Electron + pnpm compatibility: electron-builder expects a flat node_modules
# layout to correctly bundle transitive dependencies into the app.asar.
# pnpm's default isolated symlink structure causes transitive deps (e.g. ms
# required by debug) to be missing from the asar, crashing the app on launch.
node-linker=hoisted
